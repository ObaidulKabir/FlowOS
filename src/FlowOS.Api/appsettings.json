{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": true,
  "FlowOS": {
    "Actions": {
      "AllowWildcardPluginFallback": true,
      "RejectUnknownActionTypes": false
    },
    "Capabilities": {
      "EnableRemoteInvoke": false
    }
  }
}
