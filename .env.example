# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowos

# ─── FlowOS API ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5005

# ─── FlowOS MCP ───────────────────────────────────────────────
# Generate a long random secret; never commit the deployed value.
MCP_API_KEY=replace-with-a-long-random-secret
MCP_ROLE=Admin
# Comma-separated browser origins. Native clients can leave this empty.
MCP_ALLOWED_ORIGINS=

# ─── FlowOS Dashboard ────────────────────────────────────────
DASHBOARD_PORT=3000
VITE_API_TARGET=http://flowos-api:8080

# ─── Traefik (used by docker-compose.test.yaml) ──────────────
FLOWOS_DOMAIN=flowos.localhost
