# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowos

# ─── FlowOS API ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
UseInMemoryDatabase=false
API_PORT=5005

# ─── Live environments ───────────────────────────────────────
# Staging:    https://flowos.prospectbdltd.com
# Production: https://flowosbd.com
# Tenant keys are NOT shared across environments.
# Scripts load: .env → .env.${FLOWOS_ENV} → .env.local
FLOWOS_ENV=staging
FLOWOS_DOMAIN=flowos.prospectbdltd.com
FLOWOS_PUBLIC_ORIGIN=https://flowos.prospectbdltd.com
# Local Traefik (docker-compose.test.yaml): FLOWOS_DOMAIN=flowos.localhost

# ─── FlowOS MCP ───────────────────────────────────────────────
# Generate a long random secret; never commit the deployed value.
MCP_API_KEY=replace-with-a-long-random-secret
MCP_ROLE=Admin
# Comma-separated browser origins. Empty or * allows any Origin (required for Cursor HTTP MCP).
MCP_ALLOWED_ORIGINS=
# Client/bootstrap scripts (scripts/test-mcp-agent.*) also read these from .env.local.
MCP_URL=https://flowos.prospectbdltd.com/mcp
MCP_TENANT_ID=

# ─── FlowOS Dashboard ────────────────────────────────────────
DASHBOARD_PORT=3000
VITE_API_TARGET=http://flowos-api:8080

# ─── FlowOS Email / SMTP (admin@flowosbd.com) ───────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=admin@flowosbd.com
SMTP_PASSWORD=c#6uSkcs
SMTP_ENABLE_SSL=true
SMTP_FROM=admin@flowosbd.com

