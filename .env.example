# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowos

# ─── FlowOS API ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5005

# ─── FlowOS Dashboard ────────────────────────────────────────
DASHBOARD_PORT=3000
