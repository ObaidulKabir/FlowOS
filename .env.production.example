# FlowOS Production Environment Variables
# Copy to .env.production or set in your container deployment platform

# PostgreSQL Database Configuration
POSTGRES_USER=flowos_user
POSTGRES_PASSWORD=replace_with_a_secure_production_password
POSTGRES_DB=flowos_prod
POSTGRES_PORT=5432

# FlowOS API Configuration
API_PORT=5183

# Model Context Protocol (MCP) Server Configuration
MCP_PORT=8081
MCP_API_KEY=replace_with_a_secure_mcp_api_key_32_chars_min
MCP_ROLE=Admin
MCP_ALLOWED_ORIGINS=*
