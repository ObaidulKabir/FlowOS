# FlowOS production live environment
# Host: https://flowosbd.com
# Copy to .env.production or set FLOWOS_ENV=production. Tenant keys are not shared with staging.

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=toor
POSTGRES_DB=flowos
POSTGRES_PORT=5432

# FlowOS API Configuration
ASPNETCORE_ENVIRONMENT=Production
UseInMemoryDatabase=false
API_PORT=5183

# Model Context Protocol (MCP) Server Configuration
MCP_PORT=8081
MCP_API_KEY=replace_with_a_secure_mcp_api_key_32_chars_min
MCP_ROLE=Admin
MCP_ALLOWED_ORIGINS=*
FLOWOS_ENV=production
FLOWOS_DOMAIN=flowosbd.com
FLOWOS_PUBLIC_ORIGIN=https://flowosbd.com
MCP_URL=https://flowosbd.com/mcp/
