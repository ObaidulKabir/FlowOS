# FlowOS staging live environment
# Host: https://flowos.prospectbdltd.com
# Copy to .env.staging or set FLOWOS_ENV=staging. Tenant keys are not shared with production.

FLOWOS_ENV=staging
FLOWOS_DOMAIN=flowos.prospectbdltd.com
FLOWOS_PUBLIC_ORIGIN=https://flowos.prospectbdltd.com

POSTGRES_HOST=postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=toor
POSTGRES_DB=flowos
POSTGRES_PORT=5432

ASPNETCORE_ENVIRONMENT=Production
UseInMemoryDatabase=false
API_PORT=5183

MCP_PORT=8081
MCP_API_KEY=replace_with_a_secure_mcp_api_key_32_chars_min
MCP_ROLE=Admin
MCP_ALLOWED_ORIGINS=*
MCP_URL=https://flowos.prospectbdltd.com/mcp
