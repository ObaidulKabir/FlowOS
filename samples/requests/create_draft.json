{
  "name": "ExpenseApproval",
  "version": "1.0.0",
  "definition": {
    "events": [
      { "eventId": "EVT-SUBMIT", "name": "Submit Expense", "category": "Human", "requiredCapabilities": ["event.publish.EVT-SUBMIT"], "allowedRoles": ["User", "Employee"] },
      { "eventId": "EVT-APPROVE", "name": "Approve Expense", "category": "Human", "requiredCapabilities": ["event.publish.EVT-APPROVE"], "allowedRoles": ["Manager"] }
    ],
    "stateMachine": {
      "entityType": "Expense",
      "initialState": "Draft",
      "states": ["Draft", "Submitted", "Approved"],
      "transitions": [
        { "fromState": "Draft", "eventId": "EVT-SUBMIT", "toState": "Submitted" },
        { "fromState": "Submitted", "eventId": "EVT-APPROVE", "toState": "Approved" }
      ]
    },
    "workflow": {
      "startStepId": "Submit",
      "steps": [
        {
          "stepId": "Submit",
          "stepType": "Command",
          "requiredRoles": ["User"],
          "nextSteps": { "EVT-SUBMIT": "ManagerReview" }
        },
        {
          "stepId": "ManagerReview",
          "stepType": "HumanTask",
          "requiredRoles": ["Manager"],
          "requiredCapabilities": ["event.publish.EVT-APPROVE"],
          "nextSteps": { "EVT-APPROVE": "End" }
        },
        {
          "stepId": "End",
          "stepType": "End",
          "nextSteps": {}
        }
      ]
    },
    "roles": [
      { "name": "User", "description": "Submits expense claims", "grantedCapabilities": ["event.publish.EVT-SUBMIT"] },
      { "name": "Manager", "description": "Approver inbox", "grantedCapabilities": ["event.publish.EVT-APPROVE"] },
      { "name": "Director", "description": "Can execute Manager-gated approve without being the inbox role", "grantedCapabilities": ["event.publish.EVT-APPROVE"] }
    ],
    "capabilities": [
      { "code": "event.publish.EVT-SUBMIT", "description": "Publish the submit event" },
      { "code": "event.publish.EVT-APPROVE", "description": "Publish the approve event" }
    ]
  }
}
