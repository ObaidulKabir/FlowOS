{
  "name": "DesignConsultancy",
  "version": 1,
  "steps": [
    {
      "stepId": "Start",
      "stepType": "Command",
      "nextSteps": {
        "Default": "DesignTask"
      }
    },
    {
      "stepId": "DesignTask",
      "stepType": "HumanTask",
      "requiredRoles": ["Designer"],
      "requiredCapabilities": ["event.publish.TaskCompleted"],
      "nextSteps": {
        "TaskCompleted": "Review"
      }
    },
    {
      "stepId": "Review",
      "stepType": "HumanTask",
      "requiredRoles": ["Manager"],
      "requiredCapabilities": ["event.publish.EVT-DESIGN-APPROVED", "event.publish.EVT-DESIGN-REJECTED"],
      "nextSteps": {
        "EVT-DESIGN-APPROVED": "END",
        "EVT-DESIGN-REJECTED": "Rejected"
      }
    },
    {
      "stepId": "Rejected",
      "stepType": "Command",
      "nextSteps": {
          "Default": "END"
      }
    }
  ]
}