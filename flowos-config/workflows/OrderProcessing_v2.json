{
  "name": "OrderProcessing",
  "version": 2,
  "steps": [
    {
      "stepId": "Start",
      "stepType": "Command",
      "nextSteps": {
        "Default": "RiskCheck"
      }
    },
    {
      "stepId": "RiskCheck",
      "stepType": "Command",
      "nextSteps": {
        "Default": "CheckStock"
      }
    },
    {
      "stepId": "CheckStock",
      "stepType": "Command",
      "nextSteps": {
        "Default": "ApproveOrder"
      }
    },
    {
      "stepId": "ApproveOrder",
      "stepType": "HumanTask",
      "requiredRoles": ["Manager"],
      "requiredCapabilities": ["event.publish.EVT-ORDER-APPROVED", "event.publish.EVT-ORDER-REJECTED"],
      "nextSteps": {
        "EVT-ORDER-APPROVED": "FulfillOrder",
        "EVT-ORDER-REJECTED": "Rejected"
      }
    },
    {
      "stepId": "FulfillOrder",
      "stepType": "Command",
      "nextSteps": {
        "Default": "End"
      }
    },
    {
      "stepId": "Rejected",
      "stepType": "Command",
      "nextSteps": {}
    },
    {
      "stepId": "End",
      "stepType": "Command",
      "nextSteps": {}
    }
  ]
}